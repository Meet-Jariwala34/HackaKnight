# Groq (LLM) — required
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EVAL_MODEL=llama-3.3-70b-versatile

# Faster-Whisper (STT) — local model, no API key
WHISPER_MODEL=distil-medium.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Kokoro (TTS) — local model, no API key
KOKORO_VOICE=af_heart

# Backend integration (optional) — WebSocket URL your backend hosts.
# Leave blank to run fully standalone with no backend at all.
BACKEND_WS_URL=

LOG_LEVEL=INFO
